\

#!/usr/bin/env bash

set -e

BINDIR=$(dirname "$0")
# Resolve the actual path to this script, handling symlinks
# Use node to resolve the real path, which handles symlinks correctly
SCRIPT_PATH=$(node -e "console.log(require('fs').realpathSync(process.argv[1]))" "$0")
SRCDIR=$(dirname "$(dirname "$SCRIPT_PATH")")

while [ $# -gt 0 ]; do
    case "$1" in
        fix ) :
            FIX=1
            ;;
        init ) :
            INIT=1
            ;;
        update ) :
            UPDATE=1
            ;;
    esac
    shift
done

if [ -n "$INIT" ] || [ -n "$UPDATE" ]; then
  if [ -n "$INIT" ]; then
    echo "[@diplodoc/lint] Extend package.json configuration"
    node "$SRCDIR/scripts/modify-package.js"

    $BINDIR/husky init
  fi

  echo "[@diplodoc/lint] Add initial lint configs"
  # Copy all scaffolding files using Node.js for cross-platform compatibility
  # This handles Windows paths correctly and ensures files are overwritten
  node "$SRCDIR/scripts/copy-scaffolding.js"

  echo "[@diplodoc/lint] Extend .ignore configuration"
  node "$SRCDIR/scripts/modify-ignore.js"

  echo "[@diplodoc/lint] Setup release-please configuration"
  node "$SRCDIR/scripts/modify-release-please.js"

  exit 0
fi

if [ -n "$FIX" ]; then
  echo "Run linters in fix mode"

  $BINDIR/eslint '**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}' --fix
  $BINDIR/prettier --write '**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}'
  if [ -n "$(find . -type f \( -name '*.css' -o -name '*.scss' \) | grep -vwFf .stylelintignore 2>/dev/null || true)" ]; then
    $BINDIR/stylelint '**/*.{css,scss}' --fix
  fi

  exit 0
fi

echo "Run linters"

$BINDIR/eslint '**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}'
$BINDIR/prettier --check '**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}'
if [ -n "$(find . -type f \( -name '*.css' -o -name '*.scss' \) | grep -vwFf .stylelintignore 2>/dev/null || true)" ]; then
  $BINDIR/stylelint '**/*.{css,scss}'
fi
